{
  "name": "@goblin/tool-markdown-to-pdf",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./src/ui/index.tsx"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./src/api/index.ts"
    }
  },
  "scripts": {
    "build:renderer": "mkdir -p assets && esbuild src/renderer/index.ts --bundle --minify --format=iife --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=fonts/[name]-[hash] --outfile=assets/renderer.js"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.9.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "ipaddr.js": "^2.5.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "prettier": "^3.5.3",
    "puppeteer-core": "^25.18.1",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^5.1.0",
    "i18next": "^25.2.1",
    "react": "^19.1.0",
    "react-i18next": "^15.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.12",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.3.2",
    "vitest": "^3.2.7"
  }
}
