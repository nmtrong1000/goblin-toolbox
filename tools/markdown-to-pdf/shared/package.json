{
  "name": "@goblin/tool-markdown-to-pdf-shared",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./options": "./src/options.ts",
    "./renderer": "./src/renderer/index.ts"
  },
  "scripts": {
    "build": "mkdir -p assets && esbuild src/renderer/index.ts --bundle --minify --format=iife --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=fonts/[name]-[hash] --outfile=assets/renderer.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "esbuild": "catalog:"
  }
}
