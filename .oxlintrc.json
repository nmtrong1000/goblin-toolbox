{
  "$schema": "https://oxc.rs/schemas/oxlintrc.json",
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/assets/**"],
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\.?/",
            "message": "Use a #/ subpath import inside a package, or the package name across packages."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["host/src/**/*.tsx", "tools/*/ui/src/**/*.tsx", "packages/*/src/**/*.tsx"],
      "rules": {
        "react/no-multi-comp": "error",
        "max-lines": [
          "error",
          {
            "max": 200,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["**/*.ts", "**/*.mjs", "**/*.js"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "camelCase"
          }
        ]
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "pascalCase"
          }
        ]
      }
    },
    {
      "files": ["**/src/main.tsx", "**/src/bootstrap.tsx", "**/src/app/router.tsx"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "camelCase"
          }
        ]
      }
    },
    {
      "files": ["host/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?/",
                "message": "Use a #/ subpath import inside a package, or the package name across packages."
              },
              {
                "group": ["@goblin/tool-*", "@goblin/tool-*/**"],
                "message": "The Host never imports tool code; it loads tools through catalog.json."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tools/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?/",
                "message": "Use a #/ subpath import inside a package, or the package name across packages."
              },
              {
                "group": ["@goblin/tool-*", "@goblin/tool-*/**"],
                "message": "A tool never imports another tool; move shared code to packages/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tools/markdown-to-pdf/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?/",
                "message": "Use a #/ subpath import inside a package, or the package name across packages."
              },
              {
                "group": [
                  "@goblin/tool-*",
                  "@goblin/tool-*/**",
                  "!@goblin/tool-markdown-to-pdf-*",
                  "!@goblin/tool-markdown-to-pdf-*/**"
                ],
                "message": "A tool never imports another tool; move shared code to packages/."
              }
            ]
          }
        ]
      }
    }
  ]
}
