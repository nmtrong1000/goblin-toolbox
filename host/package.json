{
  "name": "@goblin/host",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "catalog": "node scripts/buildCatalog.mjs",
    "generate-contracts": "node scripts/generateContracts.mjs",
    "dev": "node scripts/buildCatalog.mjs && node scripts/generateContracts.mjs && vite",
    "build": "node scripts/buildCatalog.mjs && node scripts/generateContracts.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@module-federation/runtime": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "^1.78.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@goblin/ui-kit": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@redocly/cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:"
  }
}
