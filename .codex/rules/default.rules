# bash
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["cp"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["fd"], decision="allow")
prefix_rule(pattern=["file"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["less"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["rm"], decision="prompt")
prefix_rule(pattern=["rmdir"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["stat"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["tee"], decision="allow")
prefix_rule(pattern=["touch"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["xargs"], decision="allow")
prefix_rule(pattern=["yq"], decision="allow")

# linting and formatting
prefix_rule(pattern=["prettier"], decision="allow")
prefix_rule(pattern=["oxlint"], decision="allow")

# cloud
prefix_rule(pattern=["vercel"], decision="allow")
prefix_rule(pattern=["vercel", "deploy"], decision="prompt")
prefix_rule(pattern=["vercel", "rm"], decision="prompt")
prefix_rule(pattern=["vercel", "env"], decision="prompt")
prefix_rule(pattern=["vercel", "project"], decision="prompt")
prefix_rule(pattern=["vercel", "alias"], decision="prompt")
prefix_rule(pattern=["vercel", "domains"], decision="prompt")
prefix_rule(pattern=["vercel", "firewall"], decision="prompt")

# package managers
prefix_rule(pattern=["pnpm"], decision="allow")
prefix_rule(pattern=["pnpm", "install"], decision="prompt")
prefix_rule(pattern=["pnpm", "add"], decision="prompt")
prefix_rule(pattern=["pnpm", "remove"], decision="prompt")
prefix_rule(pattern=["pnpm", "publish"], decision="prompt")
prefix_rule(pattern=["corepack", "pnpm"], decision="allow")
prefix_rule(pattern=["corepack", "pnpm", "install"], decision="prompt")
prefix_rule(pattern=["corepack", "pnpm", "add"], decision="prompt")
prefix_rule(pattern=["corepack", "pnpm", "remove"], decision="prompt")
prefix_rule(pattern=["corepack", "pnpm", "publish"], decision="prompt")

# testing
prefix_rule(pattern=["vitest"], decision="allow")

# version control and code hosting
prefix_rule(pattern=["gh"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "edit"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "close"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "merge"], decision="prompt")
prefix_rule(pattern=["gh", "issue", "create"], decision="prompt")
prefix_rule(pattern=["gh", "issue", "edit"], decision="prompt")
prefix_rule(pattern=["gh", "issue", "close"], decision="prompt")
prefix_rule(pattern=["gh", "release", "create"], decision="prompt")
prefix_rule(pattern=["gh", "release", "edit"], decision="prompt")
prefix_rule(pattern=["gh", "release", "delete"], decision="prompt")
prefix_rule(pattern=["gh", "repo", "edit"], decision="prompt")
prefix_rule(pattern=["gh", "workflow", "run"], decision="prompt")
prefix_rule(pattern=["git"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["git", "reset"], decision="prompt")
prefix_rule(pattern=["git", "clean"], decision="prompt")
prefix_rule(pattern=["git", "restore"], decision="prompt")
prefix_rule(pattern=["git", "checkout"], decision="prompt")
prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "rebase"], decision="prompt")
prefix_rule(pattern=["git", "merge"], decision="prompt")
prefix_rule(pattern=["git", "cherry-pick"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-d"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-D"], decision="prompt")
prefix_rule(pattern=["git", "tag", "-d"], decision="prompt")
prefix_rule(pattern=["git", "config", "--global"], decision="prompt")
prefix_rule(pattern=["git", "worktree", "add"], decision="prompt")
prefix_rule(pattern=["git", "worktree", "remove"], decision="prompt")
prefix_rule(pattern=["git", "clone"], decision="prompt")
prefix_rule(pattern=["git", "submodule", "update"], decision="prompt")
prefix_rule(pattern=["git", "-C"], decision="prompt")

# network and downloads
prefix_rule(pattern=["curl"], decision="allow")

# bundlers
prefix_rule(pattern=["esbuild"], decision="allow")
prefix_rule(pattern=["vite"], decision="allow")

# languages
prefix_rule(pattern=["node"], decision="allow")

# type checking
prefix_rule(pattern=["tsc"], decision="allow")
