{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": { "#/*": ["../backend/src/*"] },
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["index.ts", "../backend/src/**/*.ts"]
}
