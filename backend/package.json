{
  "name": "@goblin/api",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./dist/app.cjs",
      "require": "./dist/app.cjs"
    }
  },
  "scripts": {
    "build": "esbuild src/app.ts --bundle --platform=node --format=cjs --external:express --outfile=dist/app.cjs",
    "dev": "tsx watch src/dev-server.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.12",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4"
  }
}
