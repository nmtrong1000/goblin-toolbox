{
  "name": "goblin-toolbox",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "vercel dev --local --listen 5173",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter \"./tools/*/shared\" --if-present build && vitest run --no-file-parallelism",
    "test:ui": "playwright test",
    "new-tool": "node scripts/new-tool.mjs",
    "generate-contracts": "pnpm --filter @goblin/host generate-contracts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.30",
    "oxlint": "^1.15.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2",
    "vercel": "66.6.0",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
